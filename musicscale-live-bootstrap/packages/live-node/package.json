{
  "name": "@musicscale-live/node",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "package:sea": "npm run build && node scripts/build-sea.mjs"
  },
  "dependencies": {
    "@musicscale-live/domain": "file:../../packages/domain",
    "@musicscale-live/adapter-holyrics": "file:../adapters-holyrics",
    "qrcode": "^1.5.4",
    "@musicscale-live/adapter-resolume": "file:../adapters-resolume"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10",
    "@types/qrcode": "^1.5.5",
    "postject": "^1.0.0-alpha.6"
  }
}
