{
  "name": "@musicscale-live/node",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@musicscale-live/domain": "file:../../packages/domain",
    "@musicscale-live/adapter-holyrics": "file:../adapters-holyrics",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10",
    "@types/qrcode": "^1.5.5"
  }
}
