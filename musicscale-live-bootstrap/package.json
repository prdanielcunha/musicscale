{
  "name": "musicscale-live",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:live": "npm run dev --workspace @musicscale-live/web",
    "dev:node": "npm run dev --workspace @musicscale-live/node",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
