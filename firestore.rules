rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    // ==========================================
    // FUNÇÕES AUXILIARES E GLOBAIS
    // ==========================================

    function isAuthenticated() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSystemAdminEmail() {
      return request.auth != null && 
             request.auth.token != null && 
             (
               request.auth.token.email == 'pastordanielpcunha@gmail.com' || 
               request.auth.token.email == 'danielcunhapastor@gmail.com' || 
               request.auth.token.email == 'millionstreinamentos@gmail.com'
             );
    }

    function isOrgActive(orgId) {
      return true;
    }

    function checkMemberExists(orgId) {
      return (orgId is string) && (
        (
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') in ['active', 'ativo']
        ) ||
        (
          exists(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)) &&
          get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('status', '') in ['active', 'ativo']
        ) ||
        (
          exists(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)) &&
          get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('status', '') in ['active', 'ativo']
        )
      );
    }

    function hasAnyMembershipDocument(orgId) {
      return (orgId is string) && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ||
        exists(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)) ||
        exists(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid))
      );
    }

    function isOwnerOfOrg(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)) && (
        get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUid', '') == request.auth.uid || 
        get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerId', '') == request.auth.uid || 
        get(/databases/$(database)/documents/organizations/$(orgId)).data.get('owner_user_id', '') == request.auth.uid || 
        get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUserId', '') == request.auth.uid
      );
    }

    function checkOrgAccess(orgId) {
      return (
        isSystemAdminEmail() || 
        isSystemAdmin() ||
        orgId == request.auth.uid || 
        checkMemberExists(orgId) || 
        isOwnerOfOrg(orgId) ||
        (
          isAuthenticated() &&
          !hasAnyMembershipDocument(orgId) &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('organizationId', '') == orgId
        )
      );
    }

    function hasOrgContext(data) {
      return ('organizationId' in data) && checkOrgAccess(data.get('organizationId', ''));
    }
    
    function isMemberWithRole(orgId, role) {
      return (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') == role
      ) || (
        exists(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)) && 
        get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('status', '') in ['active', 'ativo'] &&
        get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('role', '') == role
      ) || (
        exists(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)) && 
        get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
        get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('role', '') == role
      ) || (
        !hasAnyMembershipDocument(orgId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('organizationId', '') == orgId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == role
      );
    }

    function hasCanonicalOrganizationRole(orgId, roles) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('organizationRole', '') in roles;
    }

    function hasCanonicalPermission(orgId, permission) {
      return hasCanonicalOrganizationRole(orgId, ['owner', 'admin']) ||
        (
          permission in ['canManageRepertoire', 'canManageScales', 'canManageChords'] &&
          hasCanonicalOrganizationRole(orgId, ['worship_leader', 'leader', 'pastor', 'minister'])
        );
    }

    function hasLegacyUsersOnlyPermission(orgId, permission) {
      return !hasAnyMembershipDocument(orgId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('organizationId', '') == orgId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in
          ['owner', 'admin', 'worship_leader', 'leader', 'Lider', 'Líder', 'pastor', 'Pastor', 'Ministro', 'ministro', 'minister', 'Minister'] &&
        permission in ['canManageRepertoire', 'canManageScales', 'canManageChords'];
    }

    function isMemberWithExplicitPermission(orgId, permission) {
      return (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('permissions', {}).get(permission, false) == true
      ) || (
        exists(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)) && 
        get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('status', '') in ['active', 'ativo'] &&
        get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('permissions', {}).get(permission, false) == true
      ) || (
        exists(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)) && 
        get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
        get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('permissions', {}).get(permission, false) == true
      );
    }

    function isOrgAdmin(orgId) {
      return isSystemAdmin() || orgId == request.auth.uid || 
             isMemberWithRole(orgId, 'admin') || 
             isMemberWithRole(orgId, 'Admin') || 
             isMemberWithRole(orgId, 'administrador') || 
             isMemberWithRole(orgId, 'Administrador') || 
             isMemberWithRole(orgId, 'owner') || 
             isMemberWithRole(orgId, 'Owner') || 
             isMemberWithRole(orgId, 'dono') || 
             isMemberWithRole(orgId, 'Dono');
    }

    function isOrgOwner(orgId) {
      return isSystemAdmin() || orgId == request.auth.uid || 
             isMemberWithRole(orgId, 'owner') || 
             isMemberWithRole(orgId, 'Owner') || 
             isMemberWithRole(orgId, 'dono') || 
             isMemberWithRole(orgId, 'Dono');
    }

    function isLegacyChordContributorWithRole(orgId, role) {
      return (
        exists(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)) &&
        get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('status', '') in ['active', 'ativo'] &&
        get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('role', '') == role
      ) || (
        exists(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)) &&
        get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
        get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('role', '') == role
      ) || (
        !hasAnyMembershipDocument(orgId) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('organizationId', '') == orgId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == role
      );
    }

    function hasLegacyCommonChordContribution(orgId) {
      return isLegacyChordContributorWithRole(orgId, 'member') ||
        isLegacyChordContributorWithRole(orgId, 'Membro') ||
        isLegacyChordContributorWithRole(orgId, 'musician') ||
        isLegacyChordContributorWithRole(orgId, 'singer');
    }

    function hasPermission(orgId, permission) {
      return isSystemAdmin() || 
             isOrgAdmin(orgId) || 
             isMemberWithExplicitPermission(orgId, permission) ||
             (
               (permission == 'canManageRepertoire' || permission == 'canManageScales' || permission == 'canManageRoles' || permission == 'canManageSettings') && 
               (
                 isMemberWithRole(orgId, 'worship_leader') || 
                 isMemberWithRole(orgId, 'leader') || 
                 isMemberWithRole(orgId, 'Lider') || 
                 isMemberWithRole(orgId, 'Líder') || 
                 isMemberWithRole(orgId, 'pastor') ||
                 isMemberWithRole(orgId, 'Pastor') ||
                 isMemberWithRole(orgId, 'Ministro') ||
                 isMemberWithRole(orgId, 'ministro') ||
                 isMemberWithRole(orgId, 'minister') ||
                 isMemberWithRole(orgId, 'Minister')
               )
             ) ||
             (
               permission == 'canManageChords' &&
               (
                 isMemberWithRole(orgId, 'worship_leader') || 
                 isMemberWithRole(orgId, 'leader') || 
                 isMemberWithRole(orgId, 'Lider') || 
                 isMemberWithRole(orgId, 'Líder') || 
                 isMemberWithRole(orgId, 'pastor') ||
                 isMemberWithRole(orgId, 'Pastor') ||
                 isMemberWithRole(orgId, 'Ministro') ||
                 isMemberWithRole(orgId, 'ministro') ||
                 isMemberWithRole(orgId, 'minister') ||
                 isMemberWithRole(orgId, 'Minister') ||
                 isLegacyChordContributorWithRole(orgId, 'member') ||
                 isLegacyChordContributorWithRole(orgId, 'Membro') ||
                 isLegacyChordContributorWithRole(orgId, 'musician') ||
                 isLegacyChordContributorWithRole(orgId, 'singer')
               )
             );
    }
    
    function isSystemAdmin() {
      return isSystemAdminEmail() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('systemRole', '') in ['ceo', 'admin', 'global_admin', 'ecosystem_owner', 'founder', 'owner', 'CEO', 'Admin', 'Global_Admin', 'Ecosystem_Owner', 'Founder', 'Owner', 'suporte', 'Suporte', 'support', 'Support'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('appRole', '') in ['ceo', 'admin', 'global_admin', 'ecosystem_owner', 'founder', 'CEO', 'Admin', 'Global_Admin', 'Ecosystem_Owner', 'Founder', 'suporte', 'Suporte', 'support', 'Support'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['ceo', 'admin', 'global_admin', 'ecosystem_owner', 'founder', 'CEO', 'Admin', 'Global_Admin', 'Ecosystem_Owner', 'Founder', 'suporte', 'Suporte', 'support', 'Support']
        )
      );
    }

    function hasCanonicalGlobalRole() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('systemRole', '') in
          ['ceo', 'global_admin', 'ecosystem_owner', 'founder'];
    }

    function hasActiveMusicScaleTenantMembership(orgId) {
      return (orgId is string) && (
        (
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') in ['active', 'ativo']
        ) ||
        (
          exists(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)) &&
          get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('status', '') in ['active', 'ativo'] &&
          (!('uid' in get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data) || get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('uid', '') == request.auth.uid) &&
          (!('userId' in get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data) || get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('userId', '') == request.auth.uid) &&
          (!('user_id' in get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data) || get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('user_id', '') == request.auth.uid) &&
          (!('organizationId' in get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data) || get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('organizationId', '') == orgId) &&
          (!('organization_id' in get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data) || get(path('/databases/' + database + '/documents/organization_members/' + request.auth.uid + '_' + orgId)).data.get('organization_id', '') == orgId)
        ) ||
        (
          exists(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)) &&
          get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
          (!('uid' in get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data) || get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('uid', '') == request.auth.uid) &&
          (!('userId' in get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data) || get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('userId', '') == request.auth.uid) &&
          (!('user_id' in get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data) || get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('user_id', '') == request.auth.uid) &&
          (!('organizationId' in get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data) || get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('organizationId', '') == orgId) &&
          (!('organization_id' in get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data) || get(path('/databases/' + database + '/documents/organization_members/' + orgId + '_' + request.auth.uid)).data.get('organization_id', '') == orgId)
        )
      );
    }

    function hasCanonicalJoinRequestReadAccess(orgId) {
      return isAuthenticated() && (
        hasCanonicalGlobalRole() ||
        (
          exists(/databases/$(database)/documents/organizations/$(orgId)) &&
          (
            get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/organizations/$(orgId)).data.get('owner_user_id', '') == request.auth.uid ||
            get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUserId', '') == request.auth.uid ||
            (
              exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') in ['active', 'ativo'] &&
              (
                get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') in ['owner', 'admin'] ||
                get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('organizationRole', '') in ['owner', 'admin']
              )
            )
          )
        )
      );
    }

    // ==========================================
    // 1. DADOS DOS USUÁRIOS
    // ==========================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isSystemAdmin() || ('organizationId' in resource.data && checkOrgAccess(resource.data.get('organizationId', ''))));
      allow create: if isAuthenticated() && (userId == request.auth.uid || isSystemAdmin() || hasOrgContext(incoming()));
      allow update: if isAuthenticated() && (
        isSystemAdmin() || 
        // User updating their own profile
        (userId == request.auth.uid && 
          (!('systemRole' in incoming()) || incoming().get('systemRole', null) == resource.data.get('systemRole', null)) &&
          (!('lifetimeAccess' in incoming()) || incoming().get('lifetimeAccess', null) == resource.data.get('lifetimeAccess', null)) &&
          (!('capabilities' in incoming()) || incoming().get('capabilities', null) == resource.data.get('capabilities', null))
        ) ||
        // Org admin updating member of their org
        (
          resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.get('organizationId', '')) &&
          (!('systemRole' in incoming()) || incoming().get('systemRole', null) == resource.data.get('systemRole', null)) &&
          (!('lifetimeAccess' in incoming()) || incoming().get('lifetimeAccess', null) == resource.data.get('lifetimeAccess', null)) &&
          (!('capabilities' in incoming()) || incoming().get('capabilities', null) == resource.data.get('capabilities', null)) &&
          (
            (!isOwner(userId) && (
              (resource.data.get('role', '') != 'owner' && resource.data.get('role', '') != 'Dono' && resource.data.get('organizationRole', '') != 'Dono' && resource.data.get('organizationRole', '') != 'owner') ||
              isOrgOwner(resource.data.get('organizationId', ''))
            ))
          )
        )
      );
      allow delete: if isAuthenticated() && (isSystemAdmin() || (resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.get('organizationId', '')) && checkOrgAccess(resource.data.get('organizationId', ''))));
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // 2. DADOS DA ORGANIZAÇÃO (CORE)
    // ==========================================

    match /organizations/{orgId} {
      allow get: if isAuthenticated() && (
        isSystemAdmin() ||
        (resource != null && resource.data.get('ownerUid', '') == request.auth.uid) ||
        (resource != null && resource.data.get('ownerId', '') == request.auth.uid) ||
        (resource != null && resource.data.get('owner_user_id', '') == request.auth.uid) ||
        (resource != null && resource.data.get('ownerUserId', '') == request.auth.uid) ||
        checkOrgAccess(orgId) ||
        orgId == request.auth.uid
      );
      allow list: if isAuthenticated() && (
        isSystemAdminEmail() ||
        resource.data.get('ownerUid', '') == request.auth.uid ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        resource.data.get('owner_user_id', '') == request.auth.uid ||
        resource.data.get('ownerUserId', '') == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.get('ownerUid', '') == request.auth.uid || 
        resource.data.get('ownerId', '') == request.auth.uid || 
        resource.data.get('owner_user_id', '') == request.auth.uid || 
        resource.data.get('ownerUserId', '') == request.auth.uid || 
        orgId == request.auth.uid ||
        (checkMemberExists(orgId) && isOrgOwner(orgId))
      );
      allow delete: if false; 

      // ---------------------------------------------------------------------------------
      // MULTI-TENANT ISOLATION (NOVA ESTRUTURA)
      // ---------------------------------------------------------------------------------
      
      match /monthly_usage/{monthStr} {
        allow read: if isAuthenticated() && checkOrgAccess(orgId);
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if isAuthenticated() && (
          uid == request.auth.uid || checkOrgAccess(orgId) || isSystemAdmin()
        );
        allow list: if isAuthenticated() && (checkOrgAccess(orgId) || isSystemAdmin());
        allow create, update, delete: if false;
      }

      match /musicscale_members/{uid} {
        allow read: if isAuthenticated() && (hasActiveMusicScaleTenantMembership(orgId) || hasCanonicalGlobalRole());
        allow create, update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read, create, update, delete: if false;
      }

      match /musicscale_invite_role_intents/{intentId} {
        allow read, create, update, delete: if false;
      }

      match /join_requests/{requestId} {
        allow read, list: if hasCanonicalJoinRequestReadAccess(orgId);
        allow create, update, delete: if false;
      }

      match /audit_logs/{document=**} {
        allow read: if isAuthenticated() && checkOrgAccess(orgId);
        allow write: if isAuthenticated() && checkOrgAccess(orgId);
      }

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (
          resource.data.recipientId == request.auth.uid
        );
        allow create: if false;
        allow update: if isAuthenticated() && (
          resource.data.recipientId == request.auth.uid && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'isArchived', 'readAt', 'archivedAt'])
        );
        allow delete: if false; // Use isArchived instead of hard delete
      }


      match /{app}/{document=**} {
        allow read: if app != 'members' && app != 'musicscale_members' && app != 'invites' && app != 'musicscale_invite_role_intents' && app != 'join_requests' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
        allow create: if app != 'members' && app != 'musicscale_members' && app != 'invites' && app != 'musicscale_invite_role_intents' && app != 'join_requests' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
        allow update, delete: if app != 'members' && app != 'musicscale_members' && app != 'invites' && app != 'musicscale_invite_role_intents' && app != 'join_requests' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
      }
    }

    match /organization_members/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || id.split('_')[0] == request.auth.uid || id.split('_')[1] == request.auth.uid || checkOrgAccess(resource.data.get('organizationId', '')));
      allow list: if isAuthenticated() && (isSystemAdmin() || resource.data.get('userId', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid || checkOrgAccess(resource.data.get('organizationId', '')));
      allow create, update, delete: if false;
    }

    // ==========================================
    // 3. MÚSICAS E REPERTÓRIO
    // ==========================================

    match /songs/{songId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && (hasCanonicalPermission(incoming().get('organizationId', ''), 'canManageRepertoire') || hasLegacyUsersOnlyPermission(incoming().get('organizationId', ''), 'canManageRepertoire') || hasLegacyCommonChordContribution(incoming().get('organizationId', '')) || hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') || hasPermission(incoming().get('organizationId', ''), 'canManageChords')) && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && (hasCanonicalPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') || hasLegacyUsersOnlyPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') || hasLegacyCommonChordContribution(resource.data.get('organizationId', '')) || hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') || hasPermission(resource.data.get('organizationId', ''), 'canManageChords')) && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && (hasCanonicalPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') || hasLegacyUsersOnlyPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') || hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire')) && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    // ==========================================
    // 4. ESCALAS E EVENTOS
    // ==========================================

    
    match /scales/{musicScaleId}/responses/{responseId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/scales/$(musicScaleId)) &&
          hasPermission(get(/databases/$(database)/documents/scales/$(musicScaleId)).data.organizationId, 'canManageScales')
        )
      );
      allow create, update, delete: if false; // Only via backend Command API
    }
    
    match /scales/{musicScaleId}/responseHistory/{historyId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        (
          exists(/databases/$(database)/documents/scales/$(musicScaleId)) &&
          hasPermission(get(/databases/$(database)/documents/scales/$(musicScaleId)).data.organizationId, 'canManageScales')
        )
      );
      allow create, update, delete: if false;
    }
    match /scales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && (hasCanonicalPermission(incoming().get('organizationId', ''), 'canManageScales') || hasLegacyUsersOnlyPermission(incoming().get('organizationId', ''), 'canManageScales') || hasPermission(incoming().get('organizationId', ''), 'canManageScales')) && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /bandScales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', ''));
    }

    match /fixedBandScales/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /liveSessions/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && (
        hasPermission(incoming().get('organizationId', ''), 'canManageScales') ||
        hasPermission(incoming().get('organizationId', ''), 'musicscale.live.conduct')
      ) && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && (
        hasPermission(resource.data.get('organizationId', ''), 'canManageScales') ||
        hasPermission(resource.data.get('organizationId', ''), 'musicscale.live.conduct')
      ) && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && (
        hasPermission(resource.data.get('organizationId', ''), 'canManageScales') ||
        hasPermission(resource.data.get('organizationId', ''), 'musicscale.live.conduct')
      ) && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /roles/{roleId} {
      allow get: if isAuthenticated() && 'organizationId' in resource.data && checkOrgAccess(resource.data.get('organizationId', ''));
      allow list: if isAuthenticated() && 'organizationId' in resource.data && (checkOrgAccess(resource.data.get('organizationId', '')) || checkMemberExists(resource.data.get('organizationId', '')) || resource.data.get('organizationId', '') == request.auth.uid);
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRoles');
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRoles') && checkOrgAccess(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRoles') && checkOrgAccess(resource.data.get('organizationId', ''));
    }

    match /locations/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageSettings') && isOrgActive(incoming().get('organizationId', ''));
      allow update, delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageSettings') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /eventTypes/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageSettings') && isOrgActive(incoming().get('organizationId', ''));
      allow update, delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageSettings') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /eventNames/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageSettings') && isOrgActive(incoming().get('organizationId', ''));
      allow update, delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageSettings') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /tags/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageSettings') && isOrgActive(incoming().get('organizationId', ''));
      allow update, delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageSettings') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /instruments/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageSettings') && isOrgActive(incoming().get('organizationId', ''));
      allow update, delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageSettings') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /suggestions/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasOrgContext(incoming()) && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    // ==========================================
    // 6. RECURSOS GLOBAIS
    // ==========================================

    match /globalSongs/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSystemAdmin();
    }

    match /songSubmissions/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || resource.data.get('submittedBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && hasOrgContext(incoming());
      allow update, delete: if isSystemAdmin();
    }
    
    // ==========================================
    // 7. ECOSYSTEM INFRASTRUCTURE COLLECTIONS
    // ==========================================
    function hasValidAnalyticsEnvelope() {
      return request.resource.data.keys().hasOnly([
        'eventType',
        'organizationId',
        'userId',
        'sessionId',
        'app',
        'metadata',
        'timestamp'
      ]) &&
      request.resource.data.keys().hasAll([
        'eventType',
        'organizationId',
        'userId',
        'sessionId',
        'app',
        'metadata',
        'timestamp'
      ]) &&
      request.resource.data.eventType is string &&
      request.resource.data.eventType.size() > 0 &&
      request.resource.data.eventType.size() <= 64 &&
      request.resource.data.organizationId is string &&
      request.resource.data.organizationId.size() <= 128 &&
      request.resource.data.userId is string &&
      request.resource.data.userId.size() <= 128 &&
      request.resource.data.sessionId is string &&
      request.resource.data.sessionId.size() > 0 &&
      request.resource.data.sessionId.size() <= 128 &&
      request.resource.data.app is string &&
      request.resource.data.app.size() > 0 &&
      request.resource.data.app.size() <= 64 &&
      request.resource.data.metadata is map &&
      request.resource.data.timestamp is timestamp;
    }

    function isValidPublicMusicScaleAnalytics() {
      let data = request.resource.data;
      let isPublicIdentity =
        data.organizationId == 'none' &&
        data.userId == 'none' &&
        data.app == 'musicscale';

      let isLandingView =
        data.eventType == 'page_view' &&
        data.metadata.keys().hasOnly(['page']) &&
        data.metadata.get('page', '') == 'sales_landing';

      let isTrialPlanChoice =
        data.eventType == 'trial_cta_clicked' &&
        data.metadata.keys().hasOnly(['action', 'source']) &&
        data.metadata.get('action', '') == 'choose_plan' &&
        data.metadata.get('source', '') == 'sales_landing_primary';

      let isDemoOpened =
        data.eventType == 'app_usage' &&
        data.metadata.keys().hasOnly(['action', 'source']) &&
        data.metadata.get('action', '') == 'sales_demo_opened' &&
        data.metadata.get('source', '') == 'sales_landing';

      let isDemoStep =
        data.eventType == 'app_usage' &&
        data.metadata.keys().hasOnly(['action', 'step']) &&
        data.metadata.get('action', '') == 'sales_demo_step_selected' &&
        data.metadata.get('step', 0) is int &&
        data.metadata.get('step', 0) >= 1 &&
        data.metadata.get('step', 0) <= 5;

      return isPublicIdentity && (
        isLandingView ||
        isTrialPlanChoice ||
        isDemoOpened ||
        isDemoStep
      );
    }

    function isValidAuthenticatedAnalytics() {
      return isAuthenticated() && (
        request.resource.data.userId == 'none' ||
        request.resource.data.userId == request.auth.uid
      );
    }

    match /analytics_events/{eventId} {
      allow create: if hasValidAnalyticsEnvelope() && (
        isValidAuthenticatedAnalytics() ||
        isValidPublicMusicScaleAnalytics()
      );
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /system_audit_logs/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if isSystemAdmin(); 
    }

    match /audits/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if isSystemAdmin(); 
    }

    match /apps/{appId} {
      allow read: if isAuthenticated(); 
      allow write: if isSystemAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    match /{path=**}/members/{uid} {
      allow read: if isAuthenticated() && (
        isSystemAdminEmail() || 
        uid == request.auth.uid ||
        (resource != null && (
          resource.data.get('uid', '') == request.auth.uid || 
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('user_id', '') == request.auth.uid
        ))
      );
    }
  }
}
