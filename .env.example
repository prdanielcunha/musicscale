# Stripe API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Your frontend URL (e.g. http://localhost:3000 or the production URL)
VITE_APP_URL=http://localhost:3000

# Firebase Admin service account JSON stringified (or set individually)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT=

# Gemini configuration
GEMINI_MODEL=gemini-3.5-flash

# FinOps configuration
AI_FINOPS_HMAC_SECRET=
AI_IMPORT_FINOPS_WRITE_PATH_ENABLED=
AI_IMPORT_FINOPS_READ_PATH_ENABLED=
AI_FINOPS_DIAGNOSTICS_ENABLED=

# AI Studio Preview Canonical API Bridge
MUSICSCALE_PREVIEW_CANONICAL_API_ENABLED=
MUSICSCALE_PREVIEW_CANONICAL_API_ORIGIN=

# Development controls
VITE_DISABLE_HMR=

